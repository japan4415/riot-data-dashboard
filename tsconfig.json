{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src", "build", "tests", "*.config.ts"]
}
